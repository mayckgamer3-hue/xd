--[[
    MokAa - Auto Spam Parry para Blade Ball
    Velocidad: ~1500 CPS (6 parrys cada 0.004s)
    GUI morada, tecla configurable, compatible con la mayoría de executors.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local VIM = game:GetService("VirtualInputManager")

local player = Players.LocalPlayer

-- ========== DETECTAR REMOTE DE PARRY ==========
local ParryRemote = nil
local Remotes = ReplicatedStorage:FindFirstChild("Remotes")
if Remotes then
    ParryRemote = Remotes:FindFirstChild("ParryAttempt") or Remotes:FindFirstChild("ParryButtonPress")
end
if not ParryRemote then
    for _, child in pairs(ReplicatedStorage:GetDescendants()) do
        if child:IsA("RemoteEvent") and (child.Name:lower():find("parry") or child.Name:lower():find("block")) then
            ParryRemote = child
            break
        end
    end
end
if not ParryRemote then
    warn("No se encontró el Remote de parry. El script no funcionará.")
else
    print("Remote de parry encontrado:", ParryRemote.Name)
end

-- ========== CONFIGURACIÓN ==========
local active = false
local spamThread = nil
local activationKey = Enum.KeyCode.F
local customKeyName = "F"
local PARRY_BATCH = 6       -- 6 parrys por ciclo
local CYCLE_DELAY = 0.004   -- 0.004s entre ciclos = 1500 CPS

-- ========== FUNCIÓN PARRY ==========
local function doParry()
    if ParryRemote then
        ParryRemote:FireServer()
    end
    -- Simular tecla F como respaldo (opcional, pero ayuda en algunos casos)
    VIM:SendKeyEvent(true, Enum.KeyCode.F, false, game)
    VIM:SendKeyEvent(false, Enum.KeyCode.F, false, game)
end

-- ========== SPAM ==========
local function startSpam()
    if spamThread then return end
    spamThread = task.spawn(function()
        while active do
            for _ = 1, PARRY_BATCH do
                if ParryRemote then ParryRemote:FireServer() end
            end
            task.wait(CYCLE_DELAY)
        end
    end)
end

local function stopSpam()
    if spamThread then
        coroutine.close(spamThread)
        spamThread = nil
    end
end

local function toggleSpam()
    active = not active
    if active then
        startSpam()
    else
        stopSpam()
    end
    -- Actualizar GUI visualmente
    if ToggleBtn then
        ToggleBtn.Text = active and "DESACTIVAR" or "ACTIVAR"
        ToggleBtn.BackgroundColor3 = active and Color3.fromRGB(120, 40, 120) or Color3.fromRGB(70, 40, 90)
    end
    if StatusLabel then
        StatusLabel.Text = active and "ACTIVO" or "INACTIVO"
        StatusLabel.TextColor3 = active and Color3.fromRGB(150, 255, 150) or Color3.fromRGB(255, 150, 150)
    end
end

-- ========== GUI MORADA PROFESIONAL ==========
local ScreenGui = Instance.new("ScreenGui", game.CoreGui)
ScreenGui.Name = "MokAaGUI"
ScreenGui.ResetOnSpawn = false

local MainFrame = Instance.new("Frame", ScreenGui)
