-- ========== FUNCIONES DE UI ==========
local function updateUI()
    if active then
        StatusLabel.Text = "● ACTIVO"
        StatusLabel.TextColor3 = Color3.fromRGB(150, 255, 150)
        ToggleBtn.Text = "DESACTIVAR"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(120, 50, 100)
        -- Efecto de brillo en el borde
        TweenService:Create(Shadow, TweenInfo.new(0.3), {Transparency = 0.2}):Play()
        TweenService:Create(AccentLine, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(200, 120, 255)}):Play()
    else
        StatusLabel.Text = "◉ INACTIVO"
        StatusLabel.TextColor3 = Color3.fromRGB(255, 120, 150)
        ToggleBtn.Text = "ACTIVAR"
        ToggleBtn.BackgroundColor3 = Color3.fromRGB(80, 60, 120)
        TweenService:Create(Shadow, TweenInfo.new(0.3), {Transparency = 0.6}):Play()
        TweenService:Create(AccentLine, TweenInfo.new(0.3), {BackgroundColor3 = Color3.fromRGB(160, 100, 220)}):Play()
    end
end

-- Evento del botón toggle
ToggleBtn.MouseButton1Click:Connect(toggleSpam)

-- ========== CAMBIO DE TECLA ==========
local waitingForKey = false

local function startKeyChange()
    waitingForKey = true
    KeyBtn.Text = "..."
    KeyBtn.BackgroundColor3 = Color3.fromRGB(100, 70, 130)
    local connection
    connection = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not waitingForKey then return end
        if gameProcessed then return end
        if input.KeyCode ~= Enum.KeyCode.Unknown then
            activationKey = input.KeyCode
            customKeyName = input.KeyCode.Name
            KeyBtn.Text = "⌨️ " .. customKeyName
            KeyBtn.BackgroundColor3 = Color3.fromRGB(60, 45, 95)
            waitingForKey = false
            connection:Disconnect()
        end
    end)
end

KeyBtn.MouseButton1Click:Connect(startKeyChange)

-- ========== TECLA RÁPIDA ==========
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if waitingForKey then return end
    if gameProcessed then return end
    if input.KeyCode == activationKey then
        toggleSpam()
    end
end)

-- ========== ARRASTRE DE LA VENTANA ==========
local dragging = false
local dragStart, startPos

MainFrame.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = MainFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = false
    end
end)

-- ========== EFECTOS HOVER EN BOTONES ==========
local function addHoverEffect(btn, normalColor, hoverColor)
    btn.MouseEnter:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = hoverColor}):Play()
    end)
    btn.MouseLeave:Connect(function()
        TweenService:Create(btn, TweenInfo.new(0.2), {BackgroundColor3 = normalColor}):Play()
    end)
end

addHoverEffect(ToggleBtn, Color3.fromRGB(80, 60, 120), Color3.fromRGB(100, 75, 150))
addHoverEffect(KeyBtn, Color3.fromRGB(60, 45, 95), Color3.fromRGB(80, 60, 120))

-- Inicializar UI
updateUI()

print("MokAa cargado correctamente | Spam ~1500 CPS | Tecla: " .. customKeyName)
